# FContex Admin 换行与编码约定
# 仓库约定 LF + UTF-8 无 BOM（见 AGENTS.md），此处强制检出为 LF，
# 避免 Windows 下 core.autocrlf=true 把文件写成 CRLF。
* text=auto eol=lf

*.php   text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.md    text eol=lf
*.html  text eol=lf
*.htm   text eol=lf
*.txt   text eol=lf
*.xml   text eol=lf
*.sql   text eol=lf
*.json  text eol=lf

# 二进制资源不做换行与编码转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.svg   text eol=lf
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.zip   binary
*.mp3   binary
*.mp4   binary
