# 运行时缓存
src/store/cache/*

# 数据库配置（含凭据，由安装向导生成；样例见 system.database.sample.php）
src/store/config/system.database.php

# docs 下的临时/参考目录（下划线开头，不纳入版本管理）
docs/_*/

# 用户上传的附件与生成的缩略图（内容数据，不纳入版本管理）
