# 运行时缓存
src/store/cache/*

# 数据库配置（含凭据，由安装向导生成；样例见 system.database.sample.php）
src/store/config/system.database.php

# docs 下的临时/参考目录（下划线开头，不纳入版本管理）
docs/_*/

# 用户上传的附件与生成的缩略图（内容数据，不纳入版本管理）
# 注意：目录一旦被整体排除，其内部文件无法单独恢复，因此逐层忽略再逐层放行
src/store/upload/*
# 例外：安装后即被引用的系统默认头像
!src/store/upload/member/
src/store/upload/member/*
!src/store/upload/member/201211/
src/store/upload/member/201211/*
!src/store/upload/member/201211/28/
src/store/upload/member/201211/28/*
!src/store/upload/member/201211/28/735951354083439.png

# Nginx/IIS 配置自 1.1.9 起仓库不维护，请参考 docs/03 第 7.11 节
# 测试环境可能自动生成同名空文件，一律忽略，避免误提交
nginx.htaccess
web.config

# 发版产物（本地打包输出目录，包本身通过 Release 分发）
dist/
